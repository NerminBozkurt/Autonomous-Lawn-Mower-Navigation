<?xml version="1.0"?>
<!--
  Autonomous lawn mower - differential drive platform.

  Sized for the professional/large robotic mower class, which is what the Nav2
  configs in config/ already assume: a 1.1 x 0.9 m footprint at 1.0 m/s. Rather
  than shrinking those parameters to fit a 0.21 m TurtleBot3 Burger, the robot
  is built to match them, and the turtlebot3_gazebo dependency disappears.

  Geometry note: the drive wheels sit on the lateral axis through base_link,
  with one caster fore and one aft. The robot therefore pivots about base_link,
  which is exactly what Nav2 assumes when it rotates the footprint polygon for
  collision checking. A rear-axle drive layout would make the symmetric
  footprint in config/ wrong.
-->
<robot name="mower" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== parameters ==================== -->
  <!-- Chassis is 0.10 m smaller than the Nav2 footprint in each direction,
       leaving a 0.05 m safety margin per side. -->
  <xacro:property name="body_length"  value="1.00"/>
  <xacro:property name="body_width"   value="0.80"/>
  <xacro:property name="body_height"  value="0.30"/>
  <xacro:property name="body_mass"    value="55.0"/>

  <xacro:property name="wheel_radius"     value="0.15"/>
  <xacro:property name="wheel_width"      value="0.08"/>
  <xacro:property name="wheel_separation" value="0.70"/>
  <xacro:property name="wheel_mass"       value="4.0"/>

  <xacro:property name="caster_radius" value="0.075"/>
  <xacro:property name="caster_xoff"   value="0.38"/>
  <xacro:property name="caster_mass"   value="1.0"/>

  <!-- Cutting width drives the coverage planner's row spacing. -->
  <xacro:property name="cutting_width"    value="0.75"/>
  <xacro:property name="cutting_diameter" value="0.70"/>

  <xacro:property name="lidar_xoff"   value="0.30"/>
  <xacro:property name="lidar_height" value="0.40"/>
  <xacro:property name="lidar_radius" value="0.05"/>
  <xacro:property name="lidar_mass"   value="0.5"/>

  <xacro:property name="PI" value="3.14159265359"/>

  <!-- ==================== inertia macros ==================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <!-- Cylinder spun about its local z; the caller rotates the whole link. -->
  <xacro:macro name="cylinder_inertia" params="m r h rpy">
    <inertial>
      <origin xyz="0 0 0" rpy="${rpy}"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2*m*r*r/5}" ixy="0" ixz="0"
               iyy="${2*m*r*r/5}" iyz="0"
               izz="${2*m*r*r/5}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================== base ==================== -->
  <!-- Ground projection. Gazebo reports the model pose in this frame, so the
       ground truth TF node must use base_footprint as its base_frame. -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- base_link sits at the drive axle, 0.15 m above ground. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="mower_green">
        <color rgba="0.20 0.45 0.20 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${body_mass}" x="${body_length}"
                       y="${body_width}" z="${body_height}"/>
  </link>

  <!-- Cutting deck: visual only. Giving it collision geometry would make it
       scrape the ground plane and fight the physics solver. -->
  <link name="cutting_deck">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${cutting_diameter/2}" length="0.04"/>
      </geometry>
      <material name="deck_grey">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="cutting_deck_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="cutting_deck"/>
    <origin xyz="0 0 ${-wheel_radius+0.06}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== drive wheels ==================== -->
  <xacro:macro name="drive_wheel" params="prefix reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black">
          <color rgba="0.08 0.08 0.08 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}"
                              h="${wheel_width}" rpy="${PI/2} 0 0"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel"/>
      <origin xyz="0 ${reflect*wheel_separation/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="100.0" velocity="20.0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <gazebo reference="${prefix}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>1.0</kd>
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel prefix="left"  reflect="1"/>
  <xacro:drive_wheel prefix="right" reflect="-1"/>

  <!-- ==================== casters ==================== -->
  <!-- Modelled as low-friction spheres rather than steered wheels: a real
       caster's swivel lag is not what this thesis measures, and free spheres
       keep the solver well behaved. -->
  <xacro:macro name="caster" params="prefix xoff">
    <link name="${prefix}_caster">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="caster_grey">
          <color rgba="0.25 0.25 0.25 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${prefix}_caster"/>
      <origin xyz="${xoff} 0 ${-(wheel_radius-caster_radius)}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${prefix}_caster">
      <mu1>0.05</mu1>
      <mu2>0.05</mu2>
      <kp>1000000.0</kp>
      <kd>1.0</kd>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
  </xacro:macro>

  <xacro:caster prefix="front" xoff="${caster_xoff}"/>
  <xacro:caster prefix="rear"  xoff="${-caster_xoff}"/>

  <!-- ==================== lidar ==================== -->
  <!-- Mounted 0.55 m above ground, 0.10 m clear of the chassis top, so the
       horizontal scan plane never clips the robot's own body. -->
  <link name="base_scan">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="0.05"/>
      </geometry>
      <material name="lidar_dark">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="0.05"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}"
                            h="0.05" rpy="0 0 0"/>
  </link>

  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="base_scan"/>
    <origin xyz="${lidar_xoff} 0 ${lidar_height}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== gazebo ==================== -->
  <gazebo reference="base_link">
    <material>Gazebo/Green</material>
  </gazebo>

  <gazebo reference="cutting_deck">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="base_scan">
    <material>Gazebo/Black</material>
    <sensor name="lidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>${-PI}</min_angle>
            <max_angle>${PI}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.20</min>
          <max>12.0</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>base_scan</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <!-- Subscribes to /cmd_vel, which nav2's velocity_smoother publishes
         (navigation_launch.py remaps cmd_vel_smoothed -> cmd_vel), so the
         smoother stays in the loop. -->
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>50.0</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${2*wheel_radius}</wheel_diameter>
      <max_wheel_torque>80.0</max_wheel_torque>
      <max_wheel_acceleration>3.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>

    <!-- Wheel TFs come from robot_state_publisher via /joint_states rather
         than from the diff drive plugin, so only one node owns them. -->
    <plugin name="joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>50.0</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
